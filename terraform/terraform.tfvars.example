# AWS Configuration
aws_region  = "us-east-1"
environment = "dev"
project_name = "mcp-server"

# Network Configuration
vpc_cidr = "10.0.0.0/16"

# Container Configuration
container_port = 8000
fargate_cpu    = "256"
fargate_memory = "512"

# ECS Service Configuration
desired_count = 2
min_capacity  = 1
max_capacity  = 4

# Logging
log_level          = "INFO"
log_retention_days = 7

# Load Balancer
alb_deletion_protection = false

# HTTPS Configuration (optional)
enable_https    = false
certificate_arn = ""

# Route53 Configuration (optional)
enable_route53  = false
route53_zone_id = ""
domain_name     = ""

# Additional Tags
tags = {
  Team = "Platform"
  Cost = "Development"
}
